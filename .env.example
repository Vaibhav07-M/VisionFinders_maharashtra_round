# Fair Drop Environment Configuration Template

# Server Port
PORT=4000
NODE_ENV=development

# Cloudflare Turnstile (Test Keys for Local Development)
# Site Key (Client-side): 1x00000000000000000000AA (always passes)
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
# Secret Key (Server-side): 1x0000000000000000000000000000000AA (always passes)
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# HMAC Signature Secret for Verifiable QR Tickets
HMAC_TICKET_SECRET=fair_drop_dev_hmac_secret_key_2026_change_in_production

# Firebase Online Cloud Firestore Configuration
# Option 1: Place serviceAccountKey.json in the project root (Recommended, ignored by git)
# Option 2: Paste the service account JSON as a string or base64 below:
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"your-project-id",...}
# Option 3: Use existing project ID with Google Cloud CLI / Cloud Run:
# FIREBASE_PROJECT_ID=your-project-id

# Firebase Local Emulator Configuration (Optional)
# FIRESTORE_EMULATOR_HOST=localhost:8080
# FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
GCLOUD_PROJECT=fair-drop-demo

# Backend API URL for Frontend
VITE_API_URL=http://localhost:4000
